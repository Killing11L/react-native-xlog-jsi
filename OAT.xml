                <filteritem type="filename" name=".yarnrc" desc="包管理配置" />
                <filteritem type="filename" name="*.podspec" desc="工程配置文件" />
            </filefilter>
            <filefilter name="defaultPolicyFilter" desc="生成文件、第三方源码及配置文件">
                <filteritem type="filepath" name="harmony/xlog_jsi/src/main/cpp/generated/.*" desc="Codegen 生成文件" />
