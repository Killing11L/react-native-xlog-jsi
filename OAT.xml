                <policyitem type="license" name="MIT" path=".*" desc="项目及 Mars 使用 MIT 许可证" />
            </policy>
        </policylist>
        <filefilterlist>
            <filefilter name="copyrightPolicyFilter" desc="生成文件、第三方源码及配置文件">
